# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# Railway public URL, for example:
# PUBLIC_BASE_URL=https://your-service.up.railway.app
PUBLIC_BASE_URL=

# Redis. Railway Redis plugin usually injects REDIS_URL automatically.
REDIS_URL=

# OpenAI-compatible third-party API.
# Examples:
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Persona source.
# Default reads the generated skill in this repo.
PERSONA_PATH=exes/demosense/SKILL.md

# Optional: put the full persona text here instead of committing exes/demosense.
# PERSONA_TEXT=

HISTORY_TURNS=12
REQUEST_TIMEOUT=60
MESSAGE_IDLE_SECONDS=10
